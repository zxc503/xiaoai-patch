#!/bin/sh /etc/rc.common

#START=59

USE_PROCD=1

LOG_TITLE=$0
mico_log() {
    logger -t $LOG_TITLE[$$] -p 3 "$*"
}


start_service() {
  h_name=$(micocfg_hostname)
  
  procd_open_instance
  procd_set_param command udhcpc -f -S -s /bin/simple_dhcp.sh -R -t 0 -i wlan0 -T 1 -x "hostname:$h_name"
  procd_set_param respawn 3600 5 0
  procd_close_instance
}

stop_service() {
  mico_log "rm /tmp/dhcp_done_flag"
  rm "/tmp/dhcp_done_flag" >/dev/null 2>&1
}

restart() {
  
  stop
  start
}
